# 数据库配置 - SQLite（无需安装 MySQL！）
DB_PATH=data/bike_share.db

# API 密钥
BIKE_API_KEY=your_bike_api_key_here
GOOGLE_KEY=your_google_key_here
ORS_KEY=your_ors_key_here

# Flask 配置
FLASK_SECRET_KEY=your_secret_key_here

# 服务器绑定配置（生产环境配合 Nginx 反向代理时使用）
# HOST=127.0.0.1   # 只监听本地回环，禁止公网直接访问 5000 端口
# PORT=5000
